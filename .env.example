# Local development (never expose development auth through a public proxy).
# Leave unset to use the embedded pgserver under DATA_DIR/pgserver.
# DATABASE_URL=postgresql://advisor:advisor@localhost:5432/advisor
READINESS_TIMEOUT_SECONDS=3
# Connections per role per process (0 disables pooling); conversation workers use two roles.
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=10
TEST_DATABASE_URL=postgresql://advisor:advisor@localhost:5432/advisor
# Relative paths resolve from the project root, including when run from backend/.
DATA_DIR=./data
DEFAULT_COLLECTION=default
AUTH_MODE=development
LLM_PROVIDER=hf-local
# Optional extra local-model turn stops as a JSON string array. Defaults to
# ["<|im_end|>"] for the default MiniCPM model and [] for other model IDs.
# Set [] to disable extra stops while retaining the model's native EOS token.
# HF_STOP_TOKEN_STRINGS=["<|im_end|>"]
EMBEDDING_PROVIDER=granite
EMBEDDING_DEVICE=cpu
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_SAMPLING_POLICY=greedy
# Explicit opt-in for models that require their own sampling defaults:
# LLM_SAMPLING_POLICY=model_default
# LLM_REASONING_EFFORT=low
OPERATION_TIMEOUT_SECONDS=120
OPERATION_MAX_CALLS=2
OPERATION_TOKEN_BUDGET=16000
CONVERSATION_CONTEXT_MAX_BYTES=12000
BATCH_OPERATION_TIMEOUT_SECONDS=172800

# Native providers: choose openai, anthropic, google, or openai-compatible.
# LLM_MODEL_ID=
# LLM_API_KEY=
# LLM_BASE_URL=             # Required for openai-compatible.
# Install backend[cloud] for native SDKs. Keys never go to the browser.
ADMIN_API_ENABLED=false
ROUTING_ENABLED=false
# PROFILE_ENCRYPTION_KEY=   # Fernet key; keep stable and back it up securely.
# ROUTING_EVAL_SUITE_HASH=  # Hash of actual approved evaluation evidence.
TOOLS_ENABLED=false
# Opt-in: the answering connection reads the scoped catalog directory (~67k
# LongCat tokens) and plans focused searches before retrieval. Its own extra
# call and reservation units (serialized prompt bytes) join the operation.
QUERY_PLANNING_ENABLED=false
# QUERY_PLANNING_TOKEN_BUDGET=300000
# One grounded citation-format rewrite, counted within the operation budget.
ANSWER_CITATION_REPAIR_ENABLED=false
# Optional extension for compatible services documenting thinking.type.
# Leave unset for other endpoints. LongCat accepts disabled.
LLM_COMPATIBLE_THINKING=
# Send prompt_cache_key for requests that share a long stable prefix (query
# planning). Verified on LongCat; leave false for endpoints that reject it.
LLM_COMPATIBLE_CACHE_KEY=false
TOOL_MAX_CALLS=4

# Iterative research advising replaces legacy query planning when enabled.
# Requires TOOLS_ENABLED=true and an authorized tools-capable cloud connection.
ADVISING_RESEARCH_ENABLED=false
RESEARCH_MAX_CALLS=12
RESEARCH_MAX_TOOL_CALLS=24
RESEARCH_OPERATION_TIMEOUT_SECONDS=240
RESEARCH_OPERATION_TOKEN_BUDGET=640000
RESEARCH_MAX_PROMPT_BYTES=48000
RESEARCH_MAX_OUTPUT_TOKENS=4096

# OIDC preparation. Keep inactive until institutional policy is approved.
# AUTH_MODE=oidc
# AUTH_SERVER_KEY=          # Base64 encoding of 32+ random bytes, stable across replicas.
# OIDC_ISSUER=https://approved-identity-provider.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://advisor.example/api/auth/callback
# Choose an explicit verified claim/value policy and/or verified email domains.
# AUTH_MEMBERSHIP_CLAIM=groups
# AUTH_MEMBERSHIP_VALUES=
# AUTH_VERIFIED_EMAIL_DOMAINS=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_TRANSACTION_TTL_SECONDS=300

# Optional dedicated Office worker. See sandbox/WORKER.md; verify live isolation first.
OFFICE_ENABLED=false
# SANDBOX_REMOTE_URL=https://private-worker.example
# SANDBOX_BEARER_TOKEN=     # Shared 32+ character secret; never a model/provider key.
SANDBOX_OFFICE_IMAGE=emory-sandbox-office:7.4.7-v1
OFFICE_TIMEOUT_SECONDS=60
OFFICE_MAX_INPUT_BYTES=16777216
OFFICE_MAX_OUTPUT_BYTES=33554432
