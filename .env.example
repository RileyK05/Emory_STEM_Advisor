# Local development (never expose development auth through a public proxy).
# Leave unset to use the embedded pgserver under DATA_DIR/pgserver.
# DATABASE_URL=postgresql://advisor:advisor@localhost:5432/advisor
READINESS_TIMEOUT_SECONDS=3
# Optional HTTP liveness/readiness port for scripts.worker (0 disables).
WORKER_HEALTH_PORT=0
# Connections per role per process (0 disables pooling); conversation workers use two roles.
DB_POOL_MAX_SIZE=20
# Replicas of this process kind at peak, for the startup connection-budget check.
DB_EXPECTED_REPLICAS=1
DB_POOL_TIMEOUT_SECONDS=10
# Server-side limits for pooled application connections (0 disables).
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
# Sync dependencies and handlers share this thread pool per process. Raise it
# together with DB_POOL_MAX_SIZE for high per-process request concurrency.
HTTP_THREADPOOL_TOKENS=40
# Opt-in atomic caps on outstanding conversation turns (0 disables each cap).
ADMISSION_MAX_PENDING_WORKSPACE=0
ADMISSION_MAX_PENDING_GLOBAL=0
# Opt-in per-student quota limits (0 means unlimited and is the default).
QUOTA_QUERIES_PER_MINUTE=0
QUOTA_QUERIES_PER_DAY=0
QUOTA_TOKENS_PER_DAY=0
QUOTA_SPEND_USD_PER_DAY=0
QUOTA_MAX_ACTIVE_JOBS=0
# Optional: docker compose --profile test up -d postgres-test (disposable DB).
TEST_DATABASE_URL=postgresql://advisor:advisor@localhost:5433/advisor_test
# Private upload indexing bounds; operator imports are unaffected.
UPLOAD_MAX_EXTRACTED_CHARS=2000000
UPLOAD_MAX_SEGMENT_CHARS=16384
UPLOAD_MAX_CHUNKS=300
UPLOAD_EMBED_BATCH_SIZE=64
UPLOAD_INDEX_TIMEOUT_SECONDS=60
# Per-workspace byte ceiling across private source uploads and saved artifact
# revisions/originals (100 MiB = 5x the 20 MiB single-upload cap).
WORKSPACE_STORAGE_MAX_BYTES=104857600
# Relative paths resolve from the project root, including when run from backend/.
DATA_DIR=./data
# Storage seam: local (default), or blob/dual once an Azure Blob client exists.
STORAGE_BACKEND=local
DEFAULT_COLLECTION=default
AUTH_MODE=development
LLM_PROVIDER=hf-local
# Optional extra local-model turn stops as a JSON string array. Defaults to
# ["<|im_end|>"] for the default MiniCPM model and [] for other model IDs.
# Set [] to disable extra stops while retaining the model's native EOS token.
# HF_STOP_TOKEN_STRINGS=["<|im_end|>"]
EMBEDDING_PROVIDER=granite
EMBEDDING_DEVICE=cpu
# Load the embedding model in a background thread at startup instead of on the
# first query. Useful on a cold local process; costs memory and startup work.
# EMBEDDER_WARMUP_ON_STARTUP=false
LLM_TIMEOUT_SECONDS=60
# Per-process, per-provider cap on model calls in flight.
LLM_MAX_CONCURRENCY=8
LLM_MAX_OUTPUT_TOKENS=1024
LLM_SAMPLING_POLICY=greedy
# Explicit opt-in for models that require their own sampling defaults:
# LLM_SAMPLING_POLICY=model_default
# LLM_REASONING_EFFORT=low
OPERATION_TIMEOUT_SECONDS=120
# Provider calls per request. Two fit a plain answer and its citation repair.
# The advisor's scoped tools need calls of their own: the tools in one turn,
# the answer, and a retry when a reply runs out of output allowance. Leave
# five when TOOLS_ENABLED=true.
OPERATION_MAX_CALLS=2
OPERATION_TOKEN_BUDGET=16000
# Conversation compaction. Cloud model windows are explicit; hf-local uses
# HF_MAX_CONTEXT when LLM_CONTEXT_WINDOW_TOKENS is unset.
# LLM_CONTEXT_WINDOW_TOKENS=128000
# Defaults true for cloud providers; hf-local defaults false.
# CONVERSATION_COMPACTION_ENABLED=true
CONVERSATION_COMPACTION_THRESHOLD=0.5
CONVERSATION_COMPACTION_KEEP_TURNS=4
CONVERSATION_COMPACTION_MAX_OUTPUT_TOKENS=2048
# 0 derives from the context window plus summary output and prompt overhead.
CONVERSATION_COMPACTION_TOKEN_BUDGET=0
# Heuristic bytes per token used for context accounting.
CONVERSATION_TOKEN_ESTIMATE_BYTES=4
# Unset derives from LLM_CONTEXT_WINDOW_TOKENS * bytes-per-token.
# CONVERSATION_CONTEXT_MAX_BYTES=512000
# HTML artifact visual review: opt in per deployment and require a vision
# capability on the selected connection profile. Install backend[visual] and
# run `python -m playwright install chromium` before enabling playwright.
VISUAL_ARTIFACT_REVIEW_ENABLED=false
# Set to sandbox after configuring SANDBOX_REMOTE_URL/TOKEN; playwright is
# local-dev only and is not the deployed path.
SCREENSHOT_RENDERER=disabled
SANDBOX_SCREENSHOT_IMAGE=emory-sandbox-browser:1.50.0-v1
SCREENSHOT_TIMEOUT_SECONDS=30
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=800
SCREENSHOT_MAX_BYTES=8388608

# Native providers: choose openai, anthropic, google, or openai-compatible.
# LLM_MODEL_ID=
# LLM_API_KEY=
# LLM_BASE_URL=             # Required for openai-compatible.
# Install backend[cloud] for native SDKs. Keys never go to the browser.
# Local administration and /metrics (loopback only).
ADMIN_API_ENABLED=false
# Institutional Admin and Debug bundles. Both require an admin DB role.
ADMIN_PANEL_ENABLED=true
DEBUG_PANEL_ENABLED=true
DEBUG_SESSION_TTL_SECONDS=28800
# First-login promotion only; manage later role changes in Admin.
# Email promotion requires a verified email claim; use subjects if the IdP omits it.
# ADMIN_BOOTSTRAP_EMAILS=advisor-admin@emory.edu
# ADMIN_BOOTSTRAP_SUBJECTS=
ROUTING_ENABLED=false
# PROFILE_ENCRYPTION_KEY=   # Fernet key; keep stable and back it up securely.
# ROUTING_EVAL_SUITE_HASH=  # Hash of actual approved evaluation evidence.
TOOLS_ENABLED=true
# Opt-in: the answering connection reads the scoped catalog directory (~67k
# LongCat tokens) and plans focused searches before retrieval. Its own extra
# call and reservation units (serialized prompt bytes) join the operation.
QUERY_PLANNING_ENABLED=false
# QUERY_PLANNING_TOKEN_BUDGET=300000
# One identity-mismatch citation rewrite, counted within the operation budget.
ANSWER_CITATION_REPAIR_ENABLED=true
# Optional extension for compatible services documenting thinking.type.
# Leave unset for other endpoints. LongCat accepts disabled.
LLM_COMPATIBLE_THINKING=
# Send prompt_cache_key for requests that share a long stable prefix (query
# planning). Verified on LongCat; leave false for endpoints that reject it.
LLM_COMPATIBLE_CACHE_KEY=false
TOOL_MAX_CALLS=4

# Iterative research advising is the default answering path. It requires
# TOOLS_ENABLED=true and an authorized tools-capable connection; hf-local keeps
# working for offline smoke scripts, and /ready reports no advising model until
# a capable connection exists.
ADVISING_RESEARCH_ENABLED=true
RESEARCH_MAX_CALLS=16
RESEARCH_MAX_TOOL_CALLS=14
RESEARCH_OPERATION_TIMEOUT_SECONDS=240
RESEARCH_OPERATION_TOKEN_BUDGET=210000
RESEARCH_MAX_PROMPT_BYTES=48000
RESEARCH_MAX_OUTPUT_TOKENS=4096
# A reply cut off at the output limit is retried with a doubled allowance, up to this.
RESEARCH_TRUNCATION_MAX_OUTPUT_TOKENS=16384

# OIDC preparation. Keep inactive until institutional policy is approved.
# AUTH_MODE=oidc
# AUTH_SERVER_KEY=          # Base64 encoding of 32+ random bytes, stable across replicas.
# OIDC_ISSUER=https://approved-identity-provider.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://advisor.example/api/auth/callback
# Choose an explicit verified claim/value policy and/or verified email domains.
# AUTH_MEMBERSHIP_CLAIM=groups
# AUTH_MEMBERSHIP_VALUES=
# AUTH_VERIFIED_EMAIL_DOMAINS=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_TRANSACTION_TTL_SECONDS=300

# Optional dedicated Office worker. See sandbox/WORKER.md; verify live isolation first.
OFFICE_ENABLED=false
# SANDBOX_REMOTE_URL=https://private-worker.example
# SANDBOX_BEARER_TOKEN=     # Shared 32+ character secret; never a model/provider key.
SANDBOX_OFFICE_IMAGE=emory-sandbox-office:7.4.7-v1
OFFICE_TIMEOUT_SECONDS=60
OFFICE_MAX_INPUT_BYTES=16777216
OFFICE_MAX_OUTPUT_BYTES=33554432
