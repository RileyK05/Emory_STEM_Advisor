{
  "name": "emory-stem-advisor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run build -- --mode browser-test && node --test tests/browser-workflows.test.mjs tests/http-client.test.mjs tests/mock-client.test.mjs tests/artifact-modules.test.mjs",
    "test:integration": "npm run build -- --mode browser-test && node --test tests/live-api-integration.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.64.0",
    "prettier": "3.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
