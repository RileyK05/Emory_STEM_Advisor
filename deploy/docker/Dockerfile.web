# Production web image: Vite build served by unprivileged nginx, proxying
# /api and /health to the API Container App so the browser keeps one origin
# (session cookies and the same-origin checks stay intact).

FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_MODE=http
ARG VITE_API_BASE_URL=
ENV VITE_API_MODE=${VITE_API_MODE} \
    VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# The Bicep module overrides this with the API Container App's HTTPS origin.
ENV API_UPSTREAM=http://api:8000

EXPOSE 8080
