server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Matches REQUEST_MAX_BYTES (21 MiB default) with a small allowance.
    client_max_body_size 21m;

    # Proxy the API so the browser sees one origin. Container Apps terminates
    # TLS at the ingress, so the public scheme is always HTTPS.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM}/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_read_timeout 10s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Separate bundles. Direct .html paths also work for local previews.
    location = /admin {
        add_header Cache-Control "no-store";
        try_files /admin.html =404;
    }

    location = /admin/ {
        add_header Cache-Control "no-store";
        try_files /admin.html =404;
    }

    location = /admin.html {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location = /debug {
        add_header Cache-Control "no-store";
        try_files /debug.html =404;
    }

    location = /debug/ {
        add_header Cache-Control "no-store";
        try_files /debug.html =404;
    }

    location = /debug.html {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
