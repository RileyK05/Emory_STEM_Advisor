# Cache-Control by path. Hashed assets are immutable; the two HTML entry points
# (the app and Admin) must never be cached, or a deploy leaves browsers on old
# bundles. An empty value sends no header, so API responses keep their own.
#
# Every add_header lives at server level: nginx drops all inherited add_header
# directives in any location that declares one of its own.
map $uri $cache_control {
    ~^/assets/                     "public, max-age=31536000, immutable";
    ~^/(index|admin)\.html$        "no-store";
    ~^/admin/?$                    "no-store";
    default                        "";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Matches REQUEST_MAX_BYTES (21 MiB default) with a small allowance.
    client_max_body_size 21m;

    # Compress the bundle and the API's JSON here, where it costs the Python
    # processes nothing. Conversation records with evidence run to hundreds of KB.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain
               text/markdown image/svg+xml;

    add_header Cache-Control $cache_control;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Proxy the API so the browser sees one origin. Container Apps terminates
    # TLS at the ingress, so the public scheme is always HTTPS.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM}/health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_read_timeout 10s;
    }

    # A missing hashed asset is a 404, never the app shell.
    location /assets/ {
        try_files $uri =404;
    }

    # The Admin bundle; /admin.html also works.
    location ~ ^/admin/?$ {
        try_files /admin.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
