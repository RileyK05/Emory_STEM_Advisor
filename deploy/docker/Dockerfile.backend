# Backend image for the Emory STEM Advisor. Two targets share one base:
#
#   prod (the default, built by deploy/azure/deploy.sh): one image, four commands
#     API:     python -m scripts.serve --host 0.0.0.0 --port 8000
#     worker:  python -m scripts.worker --concurrency 24
#     migrate: python -m scripts.migrate
#     backup:  python -m scripts.backup create ...
#   dev (compose.yaml): dev extras and tests, a reloading API; compose mounts
#     ./backend over the copied source.
#
# prod preloads the default embedding model so replicas do not race to Hugging
# Face on first use. Set PRELOAD_EMBEDDING_MODEL to match EMBEDDING_MODEL_ID.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HOME=/opt/hf

WORKDIR /workspace/backend

# CPU-only torch keeps the image portable and avoids pulling CUDA libraries.
RUN python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.4"

COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY backend/configs ./configs

EXPOSE 8000

FROM base AS dev

COPY backend/tests ./tests
RUN python -m pip install -e ".[dev,cloud]"

CMD ["python", "-m", "scripts.serve", "--host", "0.0.0.0", "--reload"]

FROM base AS prod

RUN python -m pip install -e ".[cloud]"

# Set --build-arg PRELOAD_EMBEDDING_MODEL= (empty) when build egress to Hugging
# Face is blocked; the first request then downloads into HF_HOME.
ARG PRELOAD_EMBEDDING_MODEL=ibm-granite/granite-embedding-125m-english
RUN if [ -n "${PRELOAD_EMBEDDING_MODEL}" ]; then \
        python -c "from huggingface_hub import snapshot_download; snapshot_download('${PRELOAD_EMBEDDING_MODEL}')"; \
    fi

RUN mkdir -p /workspace/data /opt/hf \
    && chown -R 10001:10001 /workspace /opt/hf

# Azure Files (SMB) is mounted root-owned, so the base runs as root. Build with
# --build-arg APP_UID=10001 once the Blob adapter replaces the local DATA_DIR
# path; UID 10001 already owns /workspace/data.
ARG APP_UID=0
USER ${APP_UID}

CMD ["python", "-m", "scripts.serve", "--host", "0.0.0.0", "--port", "8000"]
