# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
*.egg-info/
/backend/build/
.ipynb_checkpoints/

# Test scratch dirs (pytest --basetemp and manual runs)
.pytest-tmp*/
.pytest-temp-*/

# Node
node_modules/
dist/
*.tsbuildinfo
test-results/
playwright-report/
.vite/

# Env: real secrets never get committed. Templates and non-secret Vite mode
# files the test scripts load are kept.
.env
.env.*
!.env.example
!frontend/.env.browser-test

# Data: dev database, raw uploads, scraped Emory catalog/program files, eval
# sets, model caches. Regenerate with the scrape/import scripts (see AGENTS.md).
data/
uploads/
runs/

# Local manual-audit material: results, ledgers, summaries, reviews and raw
# recordings. Keep it on disk, outside version control. Test source/fixtures
# in backend/tests/ and frontend/tests/ remain versionable.
/docs/audit/tests/

# Logs
*.log

# OpenCode tool state (session goals, locks); never source
.opencode/

# A literal "%SystemDrive%" folder some Windows tools create when the variable
# isn't expanded (holds machine caches).
%SystemDrive%/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
